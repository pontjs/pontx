  "license": "MIT",
  "type": "module",
  "bin": {
    "pontx-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/*.js",
    "watch": "tsc --watch",
    "dev": "node dist/index.js /Users/hzongquan/workspace/open/pontx/examples/react-app",
    "debug": "npx @modelcontextprotocol/inspector node dist/index.js",
    "debug:project": "npx @modelcontextprotocol/inspector node dist/index.js /Users/hzongquan/workspace/open/pontx/examples/react-app"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "pontx": "workspace:*"
  },
  "dependencies": {
    "@pontx/sdk-browser-client": "^0.0.12-beta.0",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "fuse.js": "^7.1.0",
    "pontx": "^1.0.0-beta.16",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pontjs/pontx.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://pontx.dev/en",
  "bugs": {
    "url": "https://github.com/pontjs/pontx/issues"
  }
