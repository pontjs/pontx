{
  "name": "@pontx/mcp",
  "version": "1.0.0-beta.1",
  "description": "Model Context Protocol server for OpenAPI discovery, API search, Schema inspection, and type-safe code generation with Pontx",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "api-discovery",
    "agent-tools",
    "code-generation"
  ],
