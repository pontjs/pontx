{
  "name": "pontx",
  "version": "0.1.12",
  "description": "pontx spec manager",
  "main": "./cjs/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./cjs-types/index.d.cts",
        "default": "./cjs/index.cjs"
      }
    }
  },
  "bin": {
    "pontx": "bin/init.cjs"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "clean": "rimraf cjs && rimraf tsconfig.tsbuildinfo && rimraf lib"
  },
  "dependencies": {
    "@pontx/spec": "^0.1.14",
    "baidu-translate-service": "^2.2.4",
    "commander": "^13.1.0",
    "lodash": "^4.17.21",
    "picocolors": "^1.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5"
  },
  "files": [
    "lib",
    "cjs",
    "cjs-types",
    "package.json",
    "*.md"
  ],
  "keywords": [],
  "author": "jasonHzq",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@types/fs-extra": "*",
    "@types/lodash": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/pontjs/pontx.git"
  }
}