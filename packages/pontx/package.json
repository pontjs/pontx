{
  "name": "pontx",
  "version": "0.1.13",
  "description": "pontx spec manager",
  "main": "./cjs/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./cjs-types/index.d.cts",
        "default": "./cjs/index.cjs"
      }
    },
    "./setup-cli": {
      "require": "./setup-cli.cjs"
    }
  },
  "bin": {
    "pontx": "bin/init.cjs"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "clean": "rimraf cjs && rimraf tsconfig.tsbuildinfo && rimraf lib"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@pontx/spec": "workspace:*",
    "baidu-translate-service": "^2.2.4",
    "commander": "^13.1.0",
    "esbuild": "^0.20.0",
    "fuse.js": "^7.1.0",
    "jmespath": "^0.16.0",
    "lodash": "^4.17.21",
    "picocolors": "^1.1.1",
    "tslib": "^2.6.2",
    "tsx": "^4.7.0"
  },
  "files": [
    "lib",
    "cjs",
    "cjs-types",
    "bin",
    "setup-cli.cjs",
    "package.json",
    "*.md"
  ],
  "keywords": [],
  "author": "jasonHzq",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@types/fs-extra": "*",
    "@types/jmespath": "^0.15.2",
    "@types/lodash": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/pontjs/pontx.git"
  }
}