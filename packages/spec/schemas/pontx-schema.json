{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://pontx.dev/schemas/pontx-spec-2.1.json",
  "title": "PontxSpec 2.1",
  "description": "Canonical Pontx API metadata. HTTP path and method are required only for RESTFul specs.",
  "type": "object",
  "required": ["pontx", "style", "name", "apis", "components"],
  "properties": {
    "pontx": {
      "const": "2.1"
    },
    "style": {
      "enum": ["RPC", "RESTFul", "GraphQL", "AsyncAPI"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "info": {
      "type": "object",
      "additionalProperties": true
    },
    "components": {
      "type": "object",
      "required": ["schemas"],
      "properties": {
        "schemas": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/schema"
          }
        },
        "securitySchemes": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "apis": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/definitions/api"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "description": { "type": "string" },
          "variables": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "security": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/securityRequirement"
      }
    },
    "externalDocs": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "webhooks": {
      "type": "object",
      "additionalProperties": true
    },
    "asyncapi": {
      "type": "object",
      "additionalProperties": true
    },
    "envs": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "ext": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "style": { "const": "RESTFul" }
        }
      },
      "then": {
        "properties": {
          "apis": {
            "additionalProperties": {
              "allOf": [
                { "$ref": "#/definitions/api" },
                { "required": ["path", "method"] }
              ]
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "api": {
      "type": "object",
      "required": ["responses"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string", "pattern": "^/" },
        "method": {
          "enum": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "HEAD", "PATCH", "TRACE"]
        },
        "title": { "type": "string" },
        "operationId": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "consumes": { "$ref": "#/definitions/mediaTypeList" },
        "produces": { "$ref": "#/definitions/mediaTypeList" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/parameter" }
        },
        "responses": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/response" }
        },
        "deprecated": { "type": "boolean" },
        "security": {
          "type": "array",
          "items": { "$ref": "#/definitions/securityRequirement" }
        },
        "requestExamples": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "metadata": { "$ref": "#/definitions/endpointMetadata" },
        "servers": {
          "type": "array",
          "items": { "type": "object" }
        },
        "callbacks": { "type": "object" },
        "sse": { "$ref": "#/definitions/sse" },
        "externalDocs": { "type": "object" },
        "ext": { "type": "object" }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["name", "in", "schema"],
      "properties": {
        "name": { "type": "string" },
        "in": { "enum": ["query", "body", "path", "formData", "header"] },
        "required": { "type": "boolean" },
        "schema": { "$ref": "#/definitions/schema" },
        "content": { "$ref": "#/definitions/content" }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "schema": { "$ref": "#/definitions/schema" },
        "content": { "$ref": "#/definitions/content" },
        "headers": { "type": "object" }
      },
      "additionalProperties": true
    },
    "sse": {
      "type": "object",
      "required": ["events", "unknownEventPolicy"],
      "properties": {
        "events": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["dataFormat"],
            "properties": {
              "description": { "type": "string" },
              "schema": { "$ref": "#/definitions/schema" },
              "terminal": { "type": "boolean" },
              "dataFormat": { "enum": ["json", "text"] }
            },
            "additionalProperties": false
          }
        },
        "unknownEventPolicy": { "const": "preserve" }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "schema": { "$ref": "#/definitions/schema" }
        },
        "additionalProperties": true
      }
    },
    "endpointMetadata": {
      "type": "object",
      "properties": {
        "documentation": {
          "type": "object",
          "properties": {
            "status": { "type": "string" },
            "evidence": {
              "type": "array",
              "items": { "type": "string" }
            },
            "verifiedAt": { "type": "string" },
            "stabilityNote": { "type": "string" }
          },
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "permission": { "enum": ["read", "mutation"] },
            "disabledReason": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mediaTypeList": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "securityRequirement": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
