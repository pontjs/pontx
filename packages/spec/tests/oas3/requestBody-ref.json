{
  "openapi": "3.0.0",
  "info": {
    "title": "Test API with requestBody $ref",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "user",
      "description": "User operations"
    }
  ],
  "paths": {
    "/users/{id}": {
      "put": {
        "tags": ["user"],
        "operationId": "updateUser",
        "summary": "Update user with $ref requestBody",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/UserUpdate"
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "post": {
        "tags": ["user"],
        "operationId": "createUser",
        "summary": "Create user with inline requestBody",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/users/missing-ref": {
      "post": {
        "tags": ["user"],
        "operationId": "missingRef",
        "summary": "API with missing requestBody ref",
        "requestBody": {
          "$ref": "#/components/requestBodies/NotExist"
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "requestBodies": {
      "UserUpdate": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "User name"
                },
                "email": {
                  "type": "string",
                  "description": "User email"
                }
              }
            }
          }
        }
      }
    },
    "parameters": {
      "PageParam": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer"
        }
      }
    }
  }
}
