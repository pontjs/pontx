{
  "name": "@pontx/vscode",
  "displayName": "pontx",
  "description": "",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "private": true,
  "activationEvents": [
    "workspaceContains:**/pontx.config.ts",
    "onWebviewPanel:pontx-ui"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "activitybar": [
        {
          "icon": "resources/pontx.svg",
          "title": "Pontx",
          "id": "pontxApiExplorer"
        }
      ]
    },
    "commands": [
      {
        "command": "pontx.findInterface",
        "title": "查找 API",
        "icon": "$(search)"
      },
      {
        "command": "pontx.fetchRemote",
        "title": "拉取远程数据",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pontx.config",
        "title": "pontx 配置",
        "icon": "$(settings-gear)"
      },
      {
        "command": "pontx.regenerate",
        "title": "生成本地代码",
        "icon": "$(debug-start)"
      },
      {
        "command": "pontx.refreshTree",
        "title": "刷新 PontX API 目录"
      },
      {
        "command": "pontx.openApiDoc",
        "icon": "$(book)",
        "title": "查看 API 文档"
      },
      {
        "command": "pontx.revealMeta",
        "icon": "$(go-to-file)",
        "title": "查看元数据"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "pontx.revealMeta",
          "when": "view == pontxApiExplorer",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@pontx/spec": "workspace:*",
    "pontx": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "path-browserify": "^1.0.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1"
  }
}