{
  "name": "@pontx/sdk-browser-client",
  "version": "0.0.12-beta.0",
  "description": "Type-safe browser API client runtime for SDKs generated from OpenAPI with Pontx",
  "keywords": [
    "openapi",
    "browser-sdk",
    "api-client",
    "typescript",
    "code-generation",
    "pontx"
  ],
  "author": "Pontx Team",
  "license": "MIT",
  "type": "module",
  "main": "./cjs/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs"
    }
  },
  "files": [
    "cjs",
    "lib"
  ],
  "scripts": {
    "clean": "rm -rf cjs lib",
    "watch": "rollup -c -w",
    "build": "npm run clean && rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pontjs/pontx.git",
    "directory": "sdk/browser"
  },
  "homepage": "https://pontx.dev/en",
  "bugs": {
    "url": "https://github.com/pontjs/pontx/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "catalog:",
    "@types/react": "^18.2.0",
    "@vitest/ui": "^4.0.6",
    "glob": "^11.0.2",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.0.0",
    "react": "*",
    "rollup": "^4.41.1",
    "vitest": "^4.0.6"
  }
}
